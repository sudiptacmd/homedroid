+// localPortMap sends connections that reach this node's Tailscale IPs on one port to
+// another port on localhost, for hosts where a service can't listen on the port clients
+// use (Homedroid: DNS on 53, which an Android app can't bind, served on 1053).
+// TS_LOCAL_PORT_MAP="53=1053,80=8080".
+var localPortMap = func() map[uint16]uint16 {
+	m := map[uint16]uint16{}
+	for _, kv := range strings.Split(envknob.String("TS_LOCAL_PORT_MAP"), ",") {
+		from, to, ok := strings.Cut(strings.TrimSpace(kv), "=")
+		if !ok {
+			continue
+		}
+		f, err1 := strconv.ParseUint(from, 10, 16)
+		t, err2 := strconv.ParseUint(to, 10, 16)
+		if err1 == nil && err2 == nil && f > 0 && t > 0 {
+			m[uint16(f)] = uint16(t)
+		}
+	}
+	return m
+}()
+
+func mapLocalPort(p uint16) uint16 {
+	if to, ok := localPortMap[p]; ok {
+		return to
+	}
+	return p
+}
