+static void mediacodec_set_config(AVCodecContext *avctx, const uint8_t *data, int size)
+{
+    MediaCodecEncContext *s = avctx->priv_data;
+
+    if (avctx->codec_id != AV_CODEC_ID_H264 && avctx->codec_id != AV_CODEC_ID_HEVC)
+        return;
+    if (av_reallocp(&s->config, size) < 0) {
+        s->config_size = 0;
+        return;
+    }
+    memcpy(s->config, data, size);
+    s->config_size = size;
+}
+
+/* Codec2 encoders report the parameter sets in the output format (csd-0 and,
+ * for H.264, csd-1) rather than as a codec-config buffer; without this they
+ * never reach the bitstream.  */
+static void mediacodec_config_from_format(AVCodecContext *avctx, FFAMediaFormat *format)
+{
+    MediaCodecEncContext *s = avctx->priv_data;
+    uint8_t *all = NULL;
+    int all_size = 0;
+
+    for (int i = 0; i < 2; i++) {
+        const char *key = i ? "csd-1" : "csd-0";
+        void *data = NULL;
+        size_t size = 0;
+
+        if (!ff_AMediaFormat_getBuffer(format, key, &data, &size) || !data || !size)
+            continue;
+        if (av_reallocp(&all, all_size + size) >= 0) {
+            memcpy(all + all_size, data, size);
+            all_size += size;
+        } else {
+            all_size = 0;
+        }
+        if (!s->use_ndk_codec)
+            av_free(data); /* the JNI wrapper returns a copy, the NDK one doesn't */
+    }
+    if (all_size) {
+        mediacodec_set_config(avctx, all, all_size);
+        /* Also prefix the next packet, like a codec-config buffer would.  */
+        if (av_reallocp(&s->extradata, all_size) >= 0) {
+            memcpy(s->extradata, all, all_size);
+            s->extradata_size = all_size;
+        }
+    }
+    av_free(all);
+}
