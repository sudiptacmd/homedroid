<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp">

    <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:format12Hour="EEEE d MMMM"
        android:format24Hour="EEEE d MMMM"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_accent"
        android:textSize="13sp"
        android:letterSpacing="0.04" />

    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface"
        android:textSize="56sp"
        android:layout_marginTop="2dp"
        android:letterSpacing="-0.02" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot" />

        <TextView
            android:id="@+id/clock_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="12sp"
            android:textColor="@color/widget_on_surface_variant"
            android:maxLines="1"
            android:layout_marginStart="5dp"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
