<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window colours match MobileUi's curated palette, so screens open without a flash;
         the screens then draw edge to edge and apply dynamic colour themselves. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#006B58</item>
        <item name="android:colorControlActivated">#006B58</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F5FAF8</item>
        <item name="android:navigationBarColor">#E9EFEC</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F5FAF8</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#7DD8C0</item>
        <item name="android:colorControlActivated">#7DD8C0</item>
        <item name="android:statusBarColor">#0E1415</item>
        <item name="android:navigationBarColor">#1A2122</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#0E1415</item>
    </style>
    <style name="WidgetLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">#FF8A92A3</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
